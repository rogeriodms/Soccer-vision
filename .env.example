# Desenvolvimento local. Não use estas credenciais fora da sua máquina.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://football:football@127.0.0.1:5432/football_vision?schema=public
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_DURATION_MS=10800000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
FFPROBE_TIMEOUT_MS=30000

WORKER_ENABLED=true
WORKER_POLL_MS=2000
WORKER_STALE_SECONDS=900
WORKER_MAX_ATTEMPTS=2
WORKER_RETRY_BACKOFF_SECONDS=20
MAX_OBSERVATIONS=2000000
SIGNIFICANT_GAP_FACTOR=2
TEMP_TTL_HOURS=24

VISION_BASE_URL=http://127.0.0.1:8000
VISION_TIMEOUT_MS=7200000
VISION_HOST=127.0.0.1
VISION_PORT=8000
MODELS_DIR=./models
YOLO_MODEL=yolo11n.pt
VISION_DEVICE=cpu
TRACK_BUFFER_SECONDS=3
GMC_METHOD=sparseOptFlow
YOLO_AUTOINSTALL=false
YOLO_OFFLINE=true
